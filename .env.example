POSTGRES_DB=YOUR_DATABASE
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
BankAccountContext__connectionString=Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
Jwt__Secret=jwt-secret-not-less-than-32-characters
Jwt__Issuer=BankAccountApi
Jwt__Audience=BankAccountApi.Client
ASPNETCORE_ENVIRONMENT=Development
